# =============================================================================
# Client-side environment (SDK, examples, probes, check_Code)
# -----------------------------------------------------------------------------
# Copy to ``.env`` in this directory for local scripts, or export selectively:
#   cp .env.example .env
#   set -a && source .env && set +a
#
# API server variables live in ``api_server/.env.example`` (load from
# ``api_server/.env`` when starting uvicorn — see README.md).
# =============================================================================

# --- Sandbox HTTP API (most scripts; names vary) ---
SANDBOX_API_URL=http://127.0.0.1:8000
API_KEY=test-key-12345
X_API_KEY=

# Alias used by some demos:
API_URL=http://127.0.0.1:8000

# --- my_sandbox_sdk (``my_sdk/config.py`` + Sandbox constructors) ---
MY_SDK_API_URL=http://127.0.0.1:8000
MY_SDK_API_KEY=test-key-12345
MY_SDK_REQUEST_TIMEOUT=600

# Legacy / examples naming:
MY_SANDBOX_API_URL=http://127.0.0.1:8000
MY_SANDBOX_API_KEY=test-key-12345
MY_SANDBOX_REQUEST_TIMEOUT=900
MY_SANDBOX_EXECUTE_RACE_WAIT_SEC=12

# E2B-style aliases (AsyncSandbox resolves if ``api_url`` omitted):
E2B_API_URL=http://127.0.0.1:8000
E2B_API_KEY=
# Optional JSON map logical name → template_id, e.g. {"custodian-default":"python:3.11"}
E2B_TEMPLATE_MAP=

# Guest filesystem via guest ``envd`` HTTP (httpx) instead of control-plane REST:
# Set 1/true/on to route Filesystem/AsyncFilesystem through ``GET …/envd-connection``.
MY_SANDBOX_USE_ENVD_FILESYSTEM=0

# --- WebSocket agent drop-in (host scripts talking to ``WS …/agent-ws``) ---
# After ``GET /sandboxes/{id}/e2b-connection``, set ws_url + traffic_access_token.
WS_URL=ws://127.0.0.1:8000/sandboxes/sb-REPLACE/agent-ws
TRAFFIC_TOKEN=
AUTH_TOKEN=dev-local-probe

# --- Guest model probe (``ws_chat_probe.py`` → OpenAI path in agentlib) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Custodian-style host bridge (``check_Code.E2BSandboxManager``) ---
AGENTLIB_SANDBOX_WS_SCHEME=ws
AGENTLIB_SANDBOX_WS_TOKEN=
AGENTLIB_SANDBOX_PERF_DIAGNOSTICS=0
AGENTLIB_SANDBOX_PERF_DURATION_SECONDS=

# --- Optional LLM / demos (examples/*.py) — do not commit real keys ---
OPENAI_API_BASE=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
GOOGLE_API_KEY=

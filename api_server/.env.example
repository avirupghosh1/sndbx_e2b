# =============================================================================
# API server (``uvicorn``) — loaded from ``api_server/.env`` via python-dotenv
# -----------------------------------------------------------------------------
# Copy to ``.env`` and set at least ``E2B_DROPIN_WS_SECRET`` for WebSocket drop-in.
#   cp .env.example .env
#
# Client-side variables (SDK, probes) are in the repo root ``../.env.example``.
# =============================================================================

# --- Core HTTP ---
HOST=0.0.0.0
PORT=8000
DEBUG=false
DATABASE_PATH=sandboxes.db
API_KEY=test-key-12345
LOG_LEVEL=INFO

# --- Engine & Docker ---
SANDBOX_ENGINE=docker
SANDBOX_ISOLATION=docker
SANDBOX_DOCKER_OCI_RUNTIME=
DOCKER_HOST=

# --- Sandbox defaults ---
DEFAULT_TEMPLATE=python:3.11
DEFAULT_CPU_LIMIT=1
DEFAULT_MEMORY_LIMIT=512m
DEFAULT_TIMEOUT=3600

# --- Warm pool ---
SANDBOX_WARM_POOL_SIZE=0
SANDBOX_WARM_POOL_TEMPLATE_ID=python:3.11
SANDBOX_WARM_POOL_CPU=1
SANDBOX_WARM_POOL_MEMORY=512m
SANDBOX_WARM_POOL_TIMEOUT=3600
SANDBOX_WARM_POOL_PROVISION_CONCURRENCY=1
SANDBOX_SNAPSHOT_REPO=mysandbox-snap

# --- Template build ---
TEMPLATE_BUILD_CPU=2
TEMPLATE_BUILD_MEMORY=2g
TEMPLATE_READY_TIMEOUT_SEC=600
TEMPLATE_DOCKER_BUILD_TIMEOUT_SEC=3600
# parsed | docker_cli
TEMPLATE_DOCKERFILE_BUILD_MODE=parsed
TEMPLATE_DOCKERFILE_RUN_TIMEOUT_SEC=7200

# --- E2B drop-in (agent WebSocket proxy) ---
# Required for GET …/e2b-connection and WS …/agent-ws. Generate e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
E2B_DROPIN_WS_SECRET=
E2B_DROPIN_AGENT_PORT=8765
E2B_DROPIN_PUBLISH_AGENT_PORT=true
E2B_DROPIN_AUTO_START_AGENT=true
E2B_DROPIN_UPSTREAM_WS_HOST=127.0.0.1
E2B_DROPIN_UPSTREAM_OPEN_TIMEOUT_SEC=60
E2B_DROPIN_UPSTREAM_CONNECT_RETRIES=3
E2B_DROPIN_UPSTREAM_RETRY_DELAY_SEC=1.0
E2B_DROPIN_TOKEN_TTL_SEC=7200
E2B_DROPIN_PUBLIC_WS_BASE=

# --- Envd guest HTTP (filesystem / process in guest on :49983) ---
ENVD_PUBLISH_PORT=false
ENVD_PORT=49983
ENVD_UPSTREAM_HTTP_HOST=127.0.0.1
ENVD_AUTO_START=true
ENVD_BOOTSTRAP_PIP_TIMEOUT_SEC=300
ENVD_EMBED_AT_TEMPLATE_BUILD=true
# auto | none | ubuntu | <login>
ENVD_DOCKERFILE_RESTORE_USER=auto

# --- Lima VM sandboxes (optional) ---
# LIMACTL_PATH=limactl
# LIMA_SANDBOX_TEMPLATE=template://ubuntu-24.04
# LIMA_CREATE_EXTRA_ARGS=
# LIMA_START_TIMEOUT_SEC=600
# LIMA_SHELL_USE_SUDO=true
# LIMA_REMOTE_HOST=
# LIMA_REMOTE_LIMACTL_PATH=limactl
# LIMA_REMOTE_SSH_EXTRA_ARGS=

# --- Firecracker (optional; SANDBOX_ENGINE=firecracker) ---
# FIRECRACKER_BINARY=/usr/local/bin/firecracker
# FIRECRACKER_KERNEL=
# FIRECRACKER_ROOTFS=
# FIRECRACKER_GATEWAY=172.16.0.1
# FIRECRACKER_SUBNET_PREFIX=172.16.0
# FIRECRACKER_GUEST_OCTET_BASE=10
# FIRECRACKER_TAP_PATTERN=tapfc{slot}
# FIRECRACKER_TAP_SLOTS=8
# FIRECRACKER_SSH_USER=root
# FIRECRACKER_SSH_KEY=
# FIRECRACKER_SSH_KNOWN_HOSTS=/dev/null
# FIRECRACKER_ENABLE_PCI=false
# FIRECRACKER_ROOTFS_FAST_COPY=true
# FIRECRACKER_SSH_POLL_SEC=0.25
# FIRECRACKER_SNAPSHOT_DIR=
# FIRECRACKER_DOCKERFILE_ROOTFS_DIR=
# FIRECRACKER_DOCKERFILE_EXT4_MIN_MB=4096
# FIRECRACKER_DOCKERFILE_EXT4_MAX_MB=65536
# FIRECRACKER_EXT4_BUILDER_IMAGE=alpine:3.19
# FIRECRACKER_DOCKERFILE_INJECT_SSH_PUBKEY=true
